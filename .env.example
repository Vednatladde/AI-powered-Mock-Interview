# ==============================================================
# AI Mock Interview Studio - Environment Configuration
# ==============================================================

# Google Gemini API Key (Required)
# Generate your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated list of permitted frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Custom FFmpeg Path (Optional: Auto-detected if installed via winget or added to PATH)
# Example: C:\ffmpeg\bin
FFMPEG_PATH=
